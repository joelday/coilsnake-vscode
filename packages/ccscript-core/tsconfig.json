{
  "compilerOptions": {
    "composite": true,
    "module": "commonjs",
    "target": "ES2024",
    "lib": ["ES2024"],
    "outDir": "out",
    "sourceMap": true,
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "types": ["jest", "node"]
  },
  "include": ["src/**/*", "index.ts"],
  "exclude": ["node_modules", "out", "dist", "**/*.test.ts"]
}
