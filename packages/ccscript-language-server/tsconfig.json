{
  "compilerOptions": {
    "composite": true,
    "module": "commonjs",
    "target": "ES2024",
    "lib": [
      "ES2024"
    ],
    "outDir": "out",
    "sourceMap": true,
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "types": ["node"]
  },
  "references": [
    {
      "path": "../ccscript-core"
    }
  ],
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "out",
    "src/**/*.test.ts",
    "src/test/**"
  ]
}
