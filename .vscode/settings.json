// Workspace settings for monorepo
{
  "files.exclude": {
    "**/out": false, // set this to true to hide the "out" folders with compiled JS files
    "**/dist": false, // set this to true to hide the "dist" folders
    "**/*.js": { "when": "$(basename).ts" }, // Hide .js files when .ts file exists
    "**/*.d.ts": { "when": "$(basename).ts" }, // Hide .d.ts files when .ts file exists
    "**/*.js.map": true,
    "**/*.d.ts.map": true,
    "**/node_modules": true,
    "**/coverage": true
  },
  "search.exclude": {
    "**/out": true,
    "**/dist": true,
    "**/node_modules": true,
    "**/coverage": true
  },
  // TypeScript configuration
  "typescript.tsc.autoDetect": "off",
  "typescript.preferences.importModuleSpecifier": "project-relative",
  "typescript.tsdk": "node_modules/typescript/lib",

  // Editor configuration
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },

  // ESLint configuration
  "eslint.validate": ["javascript", "typescript"],
  "eslint.workingDirectories": [{ "pattern": "./packages/*" }],

  // Test configuration
  "jest.runMode": "on-demand"
}
