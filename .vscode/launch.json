// Launch configurations for monorepo workspace
// Use IntelliSense to learn about possible attributes.
// Hover to view descriptions of existing attributes.
// For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/packages/vscode-extension"
      ],
      "outFiles": [
        "${workspaceFolder}/packages/*/dist/**/*.js",
        "${workspaceFolder}/packages/*/out/**/*.js"
      ],
      "preLaunchTask": "build"
    },
    {
      "name": "Debug Language Server",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/packages/ccscript-language-server/out/server.js",
      "args": ["--stdio"],
      "outFiles": [
        "${workspaceFolder}/packages/ccscript-language-server/out/**/*.js"
      ],
      "preLaunchTask": "build"
    },
    {
      "name": "Run Core Tests",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/packages/ccscript-core/node_modules/.bin/jest",
      "args": ["--runInBand", "--no-cache"],
      "cwd": "${workspaceFolder}/packages/ccscript-core",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    }
  ],
  "compounds": [
    {
      "name": "Extension + Language Server",
      "configurations": ["Run Extension", "Debug Language Server"],
      "stopAll": true
    }
  ]
}
