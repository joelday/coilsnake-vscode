{
    "name": "coilsnake-workspace",
    "private": true,
    "description": "Monorepo for CCScript language server and VS Code extension",
    "version": "1.0.0",
    "author": {
        "name": "Joel Day",
        "url": "https://github.com/joelday"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/joelday/coilsnake-vscode.git"
    },
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "build": "npm run build --workspaces --if-present",
        "compile": "npm run compile --workspaces --if-present",
        "watch": "npm run watch --workspaces --if-present",
        "test": "npm run test --workspaces --if-present",
        "lint": "npm run lint --workspaces --if-present",
        "clean": "npm run clean --workspaces --if-present",
        "package": "npm run package --workspace=packages/vscode-extension"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@stylistic/eslint-plugin": "^5.10.0",
        "eslint": "^10.12.0",
        "typescript": "^7.0.2",
        "typescript-eslint": "^8.71.1"
    }
}
