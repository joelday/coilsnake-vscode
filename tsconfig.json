{
  "compilerOptions": {
    "target": "ES2024",
    "module": "commonjs",
    "lib": ["ES2024"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "node",
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "ccscript-core": ["./packages/ccscript-core/index.ts"],
      "ccscript-core/*": ["./packages/ccscript-core/src/*"],
      "ccscript-language-server": [
        "./packages/ccscript-language-server/src/server.ts"
      ],
      "ccscript-language-server/*": [
        "./packages/ccscript-language-server/src/*"
      ]
    }
  },
  "include": ["packages/*/src/**/*", "packages/*/*.ts"],
  "exclude": ["node_modules", "**/out", "**/dist", "coilsnake"]
}
